# Environment Configuration Contract — Hills Coffee
#
# Copy this file to .env.local and fill in real values from the Supabase project dashboard.
# Never commit .env.local or any file containing real values (.gitignore already excludes .env*).
#
# See specs/001-platform-foundation/research.md §14 and
# specs/001-platform-foundation/contracts/ for the full environment/security contract.

# --- Browser-safe (NEXT_PUBLIC_* — bundled into client-side JavaScript) ---

# Your Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase project's publishable (anon) key. Safe for the browser — RLS enforces
# authorization server-side regardless of this key's exposure.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# The canonical public site URL for this deployment (used for absolute links, metadata, etc.).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (never bundled into client-side JavaScript) ---

# Supabase service-role key. Bypasses RLS entirely.
#
# Used EXCLUSIVELY by scripts/seed-test-fixtures.ts (a standalone, test-only script — see
# specs/001-platform-foundation/contracts/test-fixture-contract.md). It MUST NEVER be imported
# by any file under src/app/, components/, or lib/supabase/{client,server}.ts — no runtime
# application code path requires it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password assigned to the three seeded test fixtures (buyer-only, buyer-and-seller,
# warehouse-admin). Read only by scripts/seed-test-fixtures.ts and by local authorization
# verification; never hardcoded in source and never printed by the script. Choose any strong
# value — the fixture accounts exist solely in the development Supabase project.
TEST_FIXTURE_PASSWORD=choose-a-strong-local-only-password
